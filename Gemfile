source "https://rubygems.org"

# Pinned to the Jekyll version GitHub Pages builds with, so a local build
# matches what gets deployed.
gem "jekyll", "~> 3.10"
gem "kramdown-parser-gfm", "~> 1.1"

group :jekyll_plugins do
  gem "jekyll-sitemap", "~> 1.4"
end

# Gems no longer bundled with Ruby 3.x that Jekyll 3 still expects.
gem "webrick", "~> 1.8"
gem "csv", "~> 3.3"
gem "base64", "~> 0.2"
gem "bigdecimal", "~> 3.1"
gem "logger", "~> 1.6"
